// Ledger — Prisma schema (PostgreSQL — Neon on Netlify; works with any hosted Postgres).
// Every view derives from these tables. JSON columns are stored as TEXT
// (JSON-serialized) and marshalled in src/lib/neon-sql.ts.
//
// binaryTargets: "native" covers local dev + Netlify build machines; the two
// "rhel" targets cover Netlify's serverless function runtimes (Amazon Linux 2
// and Amazon Linux 2023) so the query engine loads inside the deployed functions.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------- auth ---------- */

model User {
  id            String    @id @default(cuid())
  name          String    @unique
  role          String    @default("member") // 'admin' | 'member'
  // P1-1a: NOT NULL since the P1 hardening migration. v10.3 allowed null
  // ("any password opens the book") — the root of the login bypass.
  passwordHash  String
  forceLogoutAt DateTime? // sessions created before this are dead
  createdAt     DateTime  @default(now())
  // P1-5: IANA timezone (e.g. "Asia/Kathmandu") — null = UTC. Resolves
  // "today" for server-side date boundaries.
  tz            String?
  // v10 additions:
  isActive              Boolean   @default(true) // false = deactivated by admin
  passwordResetToken    String? // hex token; null when not in reset flow
  passwordResetExpires  DateTime? // when the reset token expires
  // P2-6: lean default tool set for NEW users (matrix/budget/screen
  // start OFF — lenses & niche, see TOOLS_AUDIT.md §3). P3-1 adds review.
  // Role-aware half (+people for admins) is applied by the signup route.
  // Existing users' saved dockConfig is never touched; migrations
  // 3_p2_presets + 9_p3_review_default mirror this default in SQL.
  dockConfig            String    @default("{\"enabled\":[\"habits\",\"board\",\"goals\",\"inbox\",\"notes\",\"review\"],\"keepInDock\":[\"habits\"]}") // per-user dock customization (JSON)
  // P2-1: highest ChangeLog id pruned for this user. A delta client whose
  // cursor is below this watermark may have missed pruned changes, so
  // /api/ledger?since=<cursor> falls back to a full ledger for it.
  syncWatermark         Int       @default(0)
  llmSettings           LlmSetting[]
  llmCalls              LlmCall[]
  adminActions          AdminAction[]  @relation("AdminActor")
  adminActionsTarget    AdminAction[]  @relation("AdminTarget")

  sessions       Session[]
  goals          Goal[]
  tasks          Task[]
  habits         Habit[]
  metrics        Metric[]
  importantDates ImportantDate[]
  days           Day[]
  activities     Activity[]
  dayHabits      DayHabit[]
  dayMetrics     DayMetric[]
  notes          Note[]
  inboxItems     InboxItem[]
  backups        UserBackup[]
  screenEntries  ScreenEntry[]
  changeLogs     ChangeLog[]
}

/// LLM credentials — either system-wide (userId = null) or per-user.
/// Multiple rows per userId = fallback chain (tried in priority order).
model LlmSetting {
  id        String   @id @default(cuid())
  userId    String? // null = system-wide; otherwise points to User.id
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  priority  Int      @default(0) // lower = tried first
  provider  String // 'gemini' | 'groq' | 'openai' | 'cerebras' | 'openrouter' | 'custom'
  model     String // e.g. 'gpt-4o-mini'
  apiKey    String // encrypted at rest via app-level XOR (since we have no KMS)
  baseUrl   String? // for 'custom' provider
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, priority])
}

/// Per-user snapshot for admin-initiated backups.
model UserBackup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy String // admin user id who initiated the backup
  payload   String // full user data: user row + goals/tasks/habits/etc as JSON
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Audit log for admin actions (deactivate, promote, force-logout, delete, login-as, etc.)
model AdminAction {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AdminActor", fields: [actorId], references: [id])
  targetId  String
  target    User     @relation("AdminTarget", fields: [targetId], references: [id])
  action    String // 'deactivate' | 'activate' | 'promote' | 'demote' | 'force_logout' | 'reset_link' | 'login_as' | 'delete' | 'backup_user' | 'backup_all' | 'restore' | 'self_delete'
  details   String? // arbitrary metadata (JSON)
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  // P1-1c: SHA-256 of the raw cookie token — the raw token never touches
  // the database. (Migration recreates this table; all users re-login once.)
  tokenHash   String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  // v10: when an admin uses "login as user", this is set to the admin's user id
  impersonatedBy String?

  @@index([userId])
}

/* ---------- per-user catalogs (human ids like "deep-work") ---------- */

model Goal {
  userId            String
  id                String // e.g. "deep-work"
  name              String
  unit              String   @default("hours")
  target            Float    @default(30)
  deadline          DateTime?
  weeklyTargetHours Float    @default(8)
  color             String? // stable hex; null = derived from palette
  sortOrder         Int      @default(0)
  // P2-2: 'goal' | 'hobby'. Hobbies differ from goals socially (no deadline
  // pressure), not structurally — same hours logging, tasks and colors.
  kind              String   @default("goal")
  milestones        String   @default("[]") // JSON: [{label, done}]
  createdAt         DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@id([userId, id])
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  goalId      String? // null = unassigned task (not tied to a goal)
  label       String
  status      String   @default("todo") // 'todo' | 'doing' | 'done'
  priority    String   @default("normal") // 'normal' | 'high'
  urgent      Boolean  @default(false)
  important   Boolean  @default(true)
  lastTouched DateTime @default(now())
  createdAt   DateTime @default(now())

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?  @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, status])
}

model Habit {
  userId        String
  id            String // e.g. "meditate"
  name          String
  targetPerWeek Int     @default(7)
  color         String?
  sortOrder     Int     @default(0)
  archived      Boolean @default(false) // hidden from active lists, data kept

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
}

model Metric {
  userId        String
  id            String
  name          String
  direction     String  @default("down") // 'down' | 'up'
  unit          String  @default("")
  dailyTarget   Float?
  monthlyTarget Float?
  sortOrder     Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
}

model ImportantDate {
  id              String   @id @default(cuid())
  userId          String
  label           String
  date            DateTime
  type            String   @default("event") // deadline | birthday | reminder | event
  repeatsAnnually Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/* ---------- the book ---------- */

model Day {
  userId    String
  date      DateTime
  highlight String?
  checkIn   String? // JSON: {question, answer}
  // P2-4: tomorrow's plan — JSON array of {goalId, hours, note}. Written by
  // PATCH /api/days/[date]; surfaced as the next-morning "Tonight you
  // planned…" banner. A suggestion, never an auto-write.
  plan      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  goalId    String? // free-form: goals can be created after the fact
  hours     Float
  start     String? // "09:15"
  end       String? // "11:45"
  label     String?
  createdAt DateTime @default(now())
  // P2-3: set only by client edits (PATCH /api/activities/[id]) — createdAt
  // stays untouched so provenance is preserved.
  updatedAt DateTime?
  // P2-10: client-side idempotency key. A replayed offline capture upserts
  // on (userId, clientId) instead of appending a duplicate row.
  clientId  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  // P2-5: per-goal rolls (week view, review, derivations) scan by goal.
  @@index([userId, goalId, date])
  @@unique([userId, clientId])
}

model DayHabit {
  userId  String
  date    DateTime
  habitId String
  done    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date, habitId])
  // P2-5: the consistency heatmap scans by habit, not by day.
  @@index([userId, habitId, date])
}

model DayMetric {
  userId   String
  date     DateTime
  metricId String
  value    Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date, metricId])
  // P2-5: was entirely unindexed before.
  @@index([userId, metricId, date])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  text      String
  createdAt DateTime @default(now())
  // P2-10: idempotency key for offline replay (see Activity.clientId).
  clientId  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@unique([userId, clientId])
}

model InboxItem {
  id        String   @id @default(cuid())
  userId    String
  text      String
  addedAt   DateTime @default(now())
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/* ---------- v11: screen time (Digital Wellbeing style) ---------- */

/// One row = minutes an app consumed on a given day (per user).
model ScreenEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // the day the screen time happened (UTC midnight)
  appName   String // e.g. "Instagram"
  category  String   @default("other") // social | work | entertainment | learning | health | other
  minutes   Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, appName])
  @@index([userId, date])
}

/* ---------- P2-1: delta sync (per-user change feed) ---------- */

/// Append-only feed of every ledger mutation. Written in the SAME
/// transaction as the data change, so /api/ledger?since=<cursor> can return
/// exactly what a client missed and mutations can respond with a small
/// per-entity patch instead of re-shipping the whole ledger.
/// entity: goal | task | habit | metric | importantDate | day | activity |
///         dayHabit | dayMetric | note | inbox
/// op:     upsert (fetch fresh row) | delete (drop it client-side).
/// Day-scoped rows (day/activity/dayHabit/dayMetric) also carry entityDate
/// (YYYY-MM-DD): the patch re-folds those days from current data.
/// ScreenEntry changes are NOT logged — screen time has its own API/state,
/// outside the Ledger. Backup restore writes rows directly, so it bumps
/// User.syncWatermark instead (forces a one-time full sync).
model ChangeLog {
  id         Int      @id @default(autoincrement())
  userId     String
  entity     String
  entityId   String // row id; day-scoped rows use their natural key
  entityDate String? // YYYY-MM-DD when the change is day-scoped
  op         String   @default("upsert")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
}

/* ---------- P3-2: LLM cost control ---------- */

/// One row per LLM invocation (every generateJson / chat call). Powers the
/// per-user daily token budget (LLM_DAILY_TOKEN_BUDGET, default 50k) and the
/// usage panel in Settings. Failed calls log too — that's where the money
/// can leak.
model LlmCall {
  id              String   @id @default(cuid())
  userId          String? // null = system-level call
  route           String // 'suggestions' | 'recommendations' | 'chat' | 'structure' | 'extract-date' | 'write-words' | 'test'
  provider        String
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  latencyMs       Int      @default(0)
  ok              Boolean  @default(true)
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
